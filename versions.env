# Upstream release versions used to build the host/guest images.
# Bump deliberately via a PR so any breakage in a new release is caught at review time.
# Leave a value empty to fall back to the upstream latest release at build time.
SNPHOST_TAG=
# snpguest held at v0.10.0.snpguest version v0.11.0 changed `generate id-block` to take the family/image
# ID parameters as hex instead of ASCII, while sev_verify/cvm_props.py passes ASCII, so
# the ID-block tests fail on v0.11.0. Bump once cvm_props.py is updated for hex IDs.
SNPGUEST_TAG=
BEACON_TAG=
