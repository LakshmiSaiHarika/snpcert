#!/bin/bash
set -euo pipefail
set -x

# SNPHOST_TAG is always resolved by the images Makefile (pinned in versions.env
# or the latest release) and passed in via .tags
: "${SNPHOST_TAG:?SNPHOST_TAG is not set; build through the images Makefile}"

# Download and install into DESTDIR with correct permissions
curl -fsSL "https://github.com/virtee/snphost/releases/download/${SNPHOST_TAG}/snphost" \
  | install -D -m 0755 /dev/stdin "${DESTDIR}/usr/local/bin/snphost"
