#!/bin/bash
set -euo pipefail
set -x

# BEACON_TAG is always resolved by the images Makefile (pinned in versions.env
# or the latest release) and passed in via .tags
: "${BEACON_TAG:?BEACON_TAG is not set; build through the images Makefile}"

# Download and install into DESTDIR with correct permissions
curl -fsSL "https://github.com/AMDEPYC/beacon/releases/download/${BEACON_TAG}/beacon-linux-x86_64" \
  | install -D -m 0755 /dev/stdin "${DESTDIR}/usr/local/bin/beacon"
